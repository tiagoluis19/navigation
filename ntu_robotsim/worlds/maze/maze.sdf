<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze">

    <scene>
      <grid>false</grid>
    </scene>

    <physics name="10ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <!-- Gazebo Harmonic systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>

      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- =============================================================== -->
    <!-- Outer Maze -->
    <!-- =============================================================== -->

    <model name="maze">
      <static>true</static>

      <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">
        <label>100</label>
      </plugin>

      <link name="wall_1">
        <pose>0 5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.5 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.7 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_2">
        <pose>5 0 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 10 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 10 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.2 0.7 1</ambient>
            <diffuse>0.2 0.2 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_3">
        <pose>0 -5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.5 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_4">
        <pose>-5 0 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 10 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 10 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.2 1</ambient>
            <diffuse>0.7 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- =============================================================== -->
    <!-- Inner Wall 1 -->
    <!-- =============================================================== -->

    <model name="maze_inner_wall_1">
      <static>true</static>

      <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">
        <label>200</label>
      </plugin>

      <link name="link">
        <pose>-2.5 0.5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 5 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.5 0.5 1</ambient>
            <diffuse>0.3 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =============================================================== -->
    <!-- Inner Wall 2 -->
    <!-- =============================================================== -->

    <model name="maze_inner_wall_2">
      <static>true</static>

      <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">
        <label>200</label>
      </plugin>

      <link name="link">
        <pose>2.5 1.5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.5 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =============================================================== -->
    <!-- Inner Wall 3 -->
    <!-- =============================================================== -->

    <model name="maze_inner_wall_3">
      <static>true</static>

      <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">
        <label>200</label>
      </plugin>

      <link name="link">
        <pose>2 -3 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 4 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 4 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.4 0.6 0.3 1</ambient>
            <diffuse>0.4 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =============================================================== -->
    <!-- Inner Wall 4 -->
    <!-- =============================================================== -->

    <model name="maze_inner_wall_4">
      <static>true</static>

      <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">
        <label>200</label>
      </plugin>

      <link name="link">
        <pose>-3.5 -2 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>3 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>3 0.5 1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>